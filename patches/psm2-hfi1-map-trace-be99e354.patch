From be99e35465b0de6a37d9c30408256f1dc5b12ea6 Mon Sep 17 00:00:00 2001
Subject: [PATCH] psm2: trace HFI1 context mappings when explicitly enabled

The endpoint-open failure on current HFI1 systems can fault during the first
userspace access to an otherwise successful mmap.  Record the command ABI,
the base-info mapping tokens, each mmap request and successful result, and the
before/after bracket of mappings PSM2 touches.

The trace is disabled unless PSM2_HFI1_MAP_TRACE is nonempty and not "0".
It preserves errno around output and does not alter tokens, request sizes,
protections, or control flow.

---
diff --git a/psm_hal_gen1/opa_proto_gen1.c b/psm_hal_gen1/opa_proto_gen1.c
index 868f06e..899a4b7 100644
--- a/psm_hal_gen1/opa_proto_gen1.c
+++ b/psm_hal_gen1/opa_proto_gen1.c
@@ -72,6 +72,90 @@
 
 #include <sched.h>
 
+static bool hfi1_map_trace_enabled(void)
+{
+	const char *value = getenv("PSM2_HFI1_MAP_TRACE");
+
+	return value && value[0] && strcmp(value, "0");
+}
+
+static void hfi1_map_tracef(const char *format, ...)
+{
+	va_list args;
+	int saved_errno = errno;
+
+	if (!hfi1_map_trace_enabled()) {
+		errno = saved_errno;
+		return;
+	}
+
+	fputs("PSM2-HFI1-MAP: ", stderr);
+	va_start(args, format);
+	vfprintf(stderr, format, args);
+	va_end(args);
+	fputc('\n', stderr);
+	fflush(stderr);
+	errno = saved_errno;
+}
+
+static void hfi1_map_trace_request(const char *member, __u64 token,
+					   size_t length, int prot)
+{
+	__off64_t offset;
+	int saved_errno = errno;
+
+	if (!hfi1_map_trace_enabled()) {
+		errno = saved_errno;
+		return;
+	}
+
+	offset = U64_TO_OFF64_PGMASK(token);
+	hfi1_map_tracef("mmap request member=%s token=0x%llx offset=0x%llx "
+			"delta=0x%llx length=%zu prot=0x%x", member,
+			(unsigned long long)token, (unsigned long long)offset,
+			(unsigned long long)(token - (__u64)offset), length, prot);
+	errno = saved_errno;
+}
+
+static void hfi1_map_trace_base_info(const struct hfi1_base_info *binfo)
+{
+	hfi1_map_tracef("user_info result type=hfi1_base_info size=%zu "
+			"hw=0x%x sw=0x%x sc_credits=0x%llx pio_sop=0x%llx "
+			"pio=0x%llx rcvhdr=0x%llx rcvegr=0x%llx sdma=0x%llx",
+			sizeof(*binfo), binfo->hw_version, binfo->sw_version,
+			(unsigned long long)binfo->sc_credits_addr,
+			(unsigned long long)binfo->pio_bufbase_sop,
+			(unsigned long long)binfo->pio_bufbase,
+			(unsigned long long)binfo->rcvhdr_bufbase,
+			(unsigned long long)binfo->rcvegr_bufbase,
+			(unsigned long long)binfo->sdma_comp_bufbase);
+	hfi1_map_tracef("user_info result ureg=0x%llx rtail=0x%llx events=0x%llx "
+			"status=0x%llx subctx_ureg=0x%llx subctx_egr=0x%llx "
+			"subctx_hdr=0x%llx",
+			(unsigned long long)binfo->user_regbase,
+			(unsigned long long)binfo->rcvhdrtail_base,
+			(unsigned long long)binfo->events_bufbase,
+			(unsigned long long)binfo->status_bufbase,
+			(unsigned long long)binfo->subctxt_uregbase,
+			(unsigned long long)binfo->subctxt_rcvegrbuf,
+			(unsigned long long)binfo->subctxt_rcvhdrbuf);
+}
+
+#define HFI1_MAP_REQUEST(binfo, member, length, prot) \
+	hfi1_map_trace_request(#member, (binfo)->member, (length), (prot))
+
+#define HFI1_MAP_RESULT(binfo, member) \
+	hfi1_map_tracef("mmap result member=%s addr=%p", #member, \
+			(void *)(uintptr_t)((binfo)->member))
+
+#define HFI1_MAP_TOUCH(member, address, length) do { \
+	hfi1_map_tracef("touch before member=%s addr=%p length=%zu", #member, \
+				(address), (length)); \
+	hfi_touch_mmap((address), (length)); \
+	hfi1_map_tracef("touch after member=%s addr=%p length=%zu", #member, \
+				(address), (length)); \
+} while (0)
+
 size_t arrsz[MAPSIZE_MAX] = { 0 };
 
 static int map_hfi_mem(int fd, struct _hfi_ctrl *ctrl, size_t subctxt_cnt)
@@ -88,8 +172,10 @@ static int map_hfi_mem(int fd, struct _hfi_ctrl *ctrl, size_t subctxt_cnt)
 	off = binfo->sc_credits_addr &~ HFI_MMAP_PGMASK;
 
 	sz = HFI_MMAP_PGSIZE;
+	HFI1_MAP_REQUEST(binfo, sc_credits_addr, sz, PROT_READ);
 	maddr = HFI_MMAP_ERRCHECK(fd, binfo, sc_credits_addr, sz, PROT_READ);
-	hfi_touch_mmap(maddr, sz);
+	HFI1_MAP_RESULT(binfo, sc_credits_addr);
+	HFI1_MAP_TOUCH(sc_credits_addr, maddr, sz);
 	arrsz[SC_CREDITS] = sz;
 
 	binfo->sc_credits_addr |= off;
@@ -102,13 +188,17 @@ static int map_hfi_mem(int fd, struct _hfi_ctrl *ctrl, size_t subctxt_cnt)
 	 * adequate error report. TODO: Consider sanitizing the credits value explicitly
 	 */
 	sz = cinfo->credits * CREDITS_NUM;
+	HFI1_MAP_REQUEST(binfo, pio_bufbase_sop, sz, PROT_WRITE);
 	HFI_MMAP_ERRCHECK(fd, binfo, pio_bufbase_sop, sz, PROT_WRITE);
+	HFI1_MAP_RESULT(binfo, pio_bufbase_sop);
 	arrsz[PIO_BUFBASE_SOP] = sz;
 
 
 	/* 3. Map the PIO buffer address */
 	sz = cinfo->credits * CREDITS_NUM;
+	HFI1_MAP_REQUEST(binfo, pio_bufbase, sz, PROT_WRITE);
 	HFI_MMAP_ERRCHECK(fd, binfo, pio_bufbase, sz, PROT_WRITE);
+	HFI1_MAP_RESULT(binfo, pio_bufbase);
 	arrsz[PIO_BUFBASE] = sz;
 
 
@@ -116,8 +206,10 @@ static int map_hfi_mem(int fd, struct _hfi_ctrl *ctrl, size_t subctxt_cnt)
 	 * (u16 * u16 -> max value 0xfffe0001)
 	 */
 	sz = (size_t)cinfo->rcvhdrq_cnt * cinfo->rcvhdrq_entsize;
+	HFI1_MAP_REQUEST(binfo, rcvhdr_bufbase, sz, PROT_READ);
 	maddr = HFI_MMAP_ERRCHECK(fd, binfo, rcvhdr_bufbase, sz, PROT_READ);
-	hfi_touch_mmap(maddr, sz);
+	HFI1_MAP_RESULT(binfo, rcvhdr_bufbase);
+	HFI1_MAP_TOUCH(rcvhdr_bufbase, maddr, sz);
 	arrsz[RCVHDR_BUFBASE] = sz;
 
 
@@ -125,15 +217,19 @@ static int map_hfi_mem(int fd, struct _hfi_ctrl *ctrl, size_t subctxt_cnt)
 	 * (u16 * u32. Assuming size_t's precision is 64 bits - no overflow)
 	 */
 	sz = (size_t)cinfo->egrtids * cinfo->rcvegr_size;
+	HFI1_MAP_REQUEST(binfo, rcvegr_bufbase, sz, PROT_READ);
 	maddr = HFI_MMAP_ERRCHECK(fd, binfo, rcvegr_bufbase, sz, PROT_READ);
-	hfi_touch_mmap(maddr, sz);
+	HFI1_MAP_RESULT(binfo, rcvegr_bufbase);
+	HFI1_MAP_TOUCH(rcvegr_bufbase, maddr, sz);
 	arrsz[RCVEGR_BUFBASE] = sz;
 
 
 	/* 6. Map the sdma completion queue */
 	if (cinfo->runtime_flags & HFI1_CAP_SDMA) {
 		sz = cinfo->sdma_ring_size * sizeof(struct hfi1_sdma_comp_entry);
+		HFI1_MAP_REQUEST(binfo, sdma_comp_bufbase, sz, PROT_READ);
 		HFI_MMAP_ERRCHECK(fd, binfo, sdma_comp_bufbase, sz, PROT_READ);
+		HFI1_MAP_RESULT(binfo, sdma_comp_bufbase);
 	} else {
 		sz = 0;
 		binfo->sdma_comp_bufbase = (__u64)0;
@@ -143,7 +239,9 @@ static int map_hfi_mem(int fd, struct _hfi_ctrl *ctrl, size_t subctxt_cnt)
 
 	/* 7. Map RXE per-context CSRs */
 	sz = HFI_MMAP_PGSIZE;
+	HFI1_MAP_REQUEST(binfo, user_regbase, sz, PROT_WRITE|PROT_READ);
 	HFI_MMAP_ERRCHECK(fd, binfo, user_regbase, sz, PROT_WRITE|PROT_READ);
+	HFI1_MAP_RESULT(binfo, user_regbase);
 	arrsz[USER_REGBASE] = sz;
 	/* Set up addresses for optimized register writeback routines.
  	 * This is for the real onchip registers, shared context or not
@@ -167,7 +265,9 @@ static int map_hfi_mem(int fd, struct _hfi_ctrl *ctrl, size_t subctxt_cnt)
 	/* 8. Map the rcvhdrq tail register address */
 	if (cinfo->runtime_flags & HFI1_CAP_DMA_RTAIL) {
 		sz = HFI_MMAP_PGSIZE;
+		HFI1_MAP_REQUEST(binfo, rcvhdrtail_base, sz, PROT_READ);
 		HFI_MMAP_ERRCHECK(fd, binfo, rcvhdrtail_base, sz, PROT_READ);
+		HFI1_MAP_RESULT(binfo, rcvhdrtail_base);
 	} else {
 		/* We don't use receive header queue tail register to detect new packets,
  		 * but here we save the address for false-eager-full recovery
@@ -184,7 +284,9 @@ static int map_hfi_mem(int fd, struct _hfi_ctrl *ctrl, size_t subctxt_cnt)
 	off = binfo->events_bufbase &~ HFI_MMAP_PGMASK;
 
 	sz = HFI_MMAP_PGSIZE;
+	HFI1_MAP_REQUEST(binfo, events_bufbase, sz, PROT_READ);
 	HFI_MMAP_ERRCHECK(fd, binfo, events_bufbase, sz, PROT_READ);
+	HFI1_MAP_RESULT(binfo, events_bufbase);
 	arrsz[EVENTS_BUFBASE] = sz;
 	/* keep the offset in the address */
 	binfo->events_bufbase |= off;
@@ -192,7 +294,9 @@ static int map_hfi_mem(int fd, struct _hfi_ctrl *ctrl, size_t subctxt_cnt)
 
 	/* 10. Map the status page */
 	sz = HFI_MMAP_PGSIZE;
+	HFI1_MAP_REQUEST(binfo, status_bufbase, sz, PROT_READ);
 	HFI_MMAP_ERRCHECK(fd, binfo, status_bufbase, sz, PROT_READ);
+	HFI1_MAP_RESULT(binfo, status_bufbase);
 	arrsz[STATUS_BUFBASE] = sz;
 
 
@@ -205,8 +309,10 @@ static int map_hfi_mem(int fd, struct _hfi_ctrl *ctrl, size_t subctxt_cnt)
 
 	/* 11a) subctxt_uregbase */
 	sz = HFI_MMAP_PGSIZE;
+	HFI1_MAP_REQUEST(binfo, subctxt_uregbase, sz, PROT_READ|PROT_WRITE);
 	maddr = HFI_MMAP_ERRCHECK(fd, binfo, subctxt_uregbase, sz, PROT_READ|PROT_WRITE);
-	hfi_touch_mmap(maddr, sz);
+	HFI1_MAP_RESULT(binfo, subctxt_uregbase);
+	HFI1_MAP_TOUCH(subctxt_uregbase, maddr, sz);
 	arrsz[SUBCTXT_UREGBASE] = sz;
 
 
@@ -216,8 +322,10 @@ static int map_hfi_mem(int fd, struct _hfi_ctrl *ctrl, size_t subctxt_cnt)
 	factor = (size_t)cinfo->rcvhdrq_cnt * cinfo->rcvhdrq_entsize;
 	factor = ALIGN(factor, HFI_MMAP_PGSIZE);
 	sz = factor * subctxt_cnt;
+	HFI1_MAP_REQUEST(binfo, subctxt_rcvhdrbuf, sz, PROT_READ|PROT_WRITE);
 	maddr = HFI_MMAP_ERRCHECK(fd, binfo, subctxt_rcvhdrbuf, sz, PROT_READ|PROT_WRITE);
-	hfi_touch_mmap(maddr, sz);
+	HFI1_MAP_RESULT(binfo, subctxt_rcvhdrbuf);
+	HFI1_MAP_TOUCH(subctxt_rcvhdrbuf, maddr, sz);
 	arrsz[SUBCTXT_RCVHDRBUF] = sz;
 
 
@@ -231,8 +339,10 @@ static int map_hfi_mem(int fd, struct _hfi_ctrl *ctrl, size_t subctxt_cnt)
 		_HFI_INFO("%s (rcvegrbuf)\n", errstr);
 		goto err_int_overflow_subctxt_rcvegrbuf;
 	}
+	HFI1_MAP_REQUEST(binfo, subctxt_rcvegrbuf, sz, PROT_READ|PROT_WRITE);
 	maddr = HFI_MMAP_ERRCHECK(fd, binfo, subctxt_rcvegrbuf, sz, PROT_READ|PROT_WRITE);
-	hfi_touch_mmap(maddr, sz);
+	HFI1_MAP_RESULT(binfo, subctxt_rcvegrbuf);
+	HFI1_MAP_TOUCH(subctxt_rcvegrbuf, maddr, sz);
 	arrsz[SUBCTXT_RCVEGRBUF] = sz;
 
 	return 0;
@@ -317,6 +427,11 @@ struct _hfi_ctrl *hfi_userinit_internal(int fd, bool skip_affinity,
 	cinfo = &spctrl->ctxt_info;
 	binfo = &spctrl->base_info;
 
+	hfi1_map_tracef("abi command_size=%zu user_info_dep_size=%zu "
+			"ctxt_info_size=%zu base_info_size=%zu page_size=%d",
+			sizeof(c), sizeof(*uinfo), sizeof(*cinfo), sizeof(*binfo),
+			__hfi_pg_sz);
+
 	_HFI_VDBG("uinfo: ver %x, alg %d, subc_cnt %d, subc_id %d\n",
 		  uinfo->userversion, uinfo->hfi1_alg,
 		  uinfo->subctxt_cnt, uinfo->subctxt_id);
@@ -343,6 +458,12 @@ struct _hfi_ctrl *hfi_userinit_internal(int fd, bool skip_affinity,
 		uinfo_new.subctxt_cnt = uinfo->subctxt_cnt;
 		uinfo_new.subctxt_id  = uinfo->subctxt_id;
 		memcpy(uinfo_new.uuid,uinfo->uuid,sizeof(uinfo_new.uuid));
+		hfi1_map_tracef("assign_ctxt request transport=ioctl type=hfi1_user_info "
+				"cmd_type=%u cmd_len=%u cmd_addr=%p type_size=%zu "
+				"version=0x%x subctxt_cnt=%u subctxt_id=%u",
+				c.type, c.len, (void *)(uintptr_t)c.addr, sizeof(uinfo_new),
+				uinfo_new.userversion, uinfo_new.subctxt_cnt,
+				uinfo_new.subctxt_id);
 	}
 	else
 	{
@@ -350,12 +471,25 @@ struct _hfi_ctrl *hfi_userinit_internal(int fd, bool skip_affinity,
 		   the struct hfi1_user_info_dep version of the struct: */
 		c.len = sizeof(*uinfo);
 		c.addr = (__u64) uinfo;
+		hfi1_map_tracef("assign_ctxt request transport=write type=hfi1_user_info_dep "
+				"cmd_type=%u cmd_len=%u cmd_addr=%p type_size=%zu "
+				"version=0x%x alg=%u subctxt_cnt=%u subctxt_id=%u",
+				c.type, c.len, (void *)(uintptr_t)c.addr, sizeof(*uinfo),
+				uinfo->userversion, uinfo->hfi1_alg, uinfo->subctxt_cnt,
+				uinfo->subctxt_id);
 	}
 #else
 	c.len = sizeof(*uinfo);
 	c.addr = (__u64) uinfo;
+	hfi1_map_tracef("assign_ctxt request transport=write type=hfi1_user_info_dep "
+				"cmd_type=%u cmd_len=%u cmd_addr=%p type_size=%zu "
+				"version=0x%x alg=%u subctxt_cnt=%u subctxt_id=%u",
+				c.type, c.len, (void *)(uintptr_t)c.addr, sizeof(*uinfo),
+				uinfo->userversion, uinfo->hfi1_alg, uinfo->subctxt_cnt,
+				uinfo->subctxt_id);
 #endif
 	if (hfi_cmd_write(fd, &c, sizeof(c)) == -1) {
+		hfi1_map_tracef("assign_ctxt result=-1 errno=%d", errno);
 		if (errno == ENODEV) {
 			_HFI_INFO("Warning: PSM2 and driver version mismatch\n");
 			/* Overwrite errno. One would wish that the driver
@@ -368,9 +502,15 @@ struct _hfi_ctrl *hfi_userinit_internal(int fd, bool skip_affinity,
 		goto err_hfi_cmd_assign_ctxt;
 	}
 
+	hfi1_map_tracef("assign_ctxt result=0");
+
 #ifdef PSM2_SUPPORT_IW_CMD_API
 	if (hfi_get_user_major_version() == IOCTL_CMD_API_MODULE_MAJOR)
 	{
+		hfi1_map_tracef("assign_ctxt returned type=hfi1_user_info "
+				"version=0x%x subctxt_cnt=%u subctxt_id=%u",
+				uinfo_new.userversion, uinfo_new.subctxt_cnt,
+				uinfo_new.subctxt_id);
 		/* for the new driver, we copy the results of the call back to uinfo from
 		   uinfo_new. */
 		uinfo->userversion = uinfo_new.userversion;
@@ -379,17 +519,38 @@ struct _hfi_ctrl *hfi_userinit_internal(int fd, bool skip_affinity,
 		uinfo->subctxt_id  = uinfo_new.subctxt_id;
 		memcpy(uinfo->uuid,uinfo_new.uuid,sizeof(uinfo_new.uuid));
 	}
+	else
+		hfi1_map_tracef("assign_ctxt returned type=hfi1_user_info_dep "
+				"version=0x%x alg=%u subctxt_cnt=%u subctxt_id=%u",
+				uinfo->userversion, uinfo->hfi1_alg, uinfo->subctxt_cnt,
+				uinfo->subctxt_id);
+#else
+	hfi1_map_tracef("assign_ctxt returned type=hfi1_user_info_dep "
+				"version=0x%x alg=%u subctxt_cnt=%u subctxt_id=%u",
+				uinfo->userversion, uinfo->hfi1_alg, uinfo->subctxt_cnt,
+				uinfo->subctxt_id);
 #endif
 
 	/* 2. get context info from driver */
 	c.type = PSMI_HFI_CMD_CTXT_INFO;
 	c.len = sizeof(*cinfo);
 	c.addr = (__u64) cinfo;
+	hfi1_map_tracef("ctxt_info request cmd_type=%u cmd_len=%u cmd_addr=%p "
+			"type=hfi1_ctxt_info type_size=%zu", c.type, c.len,
+			(void *)(uintptr_t)c.addr, sizeof(*cinfo));
 
 	if (hfi_cmd_write(fd, &c, sizeof(c)) == -1) {
+		hfi1_map_tracef("ctxt_info result=-1 errno=%d", errno);
 		_HFI_ERROR("CTXT_INFO command failed: %s\n", strerror(errno));
 		goto err_hfi_cmd_ctxt_info;
 	}
+	hfi1_map_tracef("ctxt_info result=0 runtime_flags=0x%llx unit=%u "
+			"ctxt=%u subctxt=%u credits=%u rcvhdrq_cnt=%u "
+			"rcvhdrq_entsize=%u egrtids=%u rcvegr_size=%u sdma_ring_size=%u",
+			(unsigned long long)cinfo->runtime_flags, cinfo->unit,
+			cinfo->ctxt, cinfo->subctxt, cinfo->credits,
+			cinfo->rcvhdrq_cnt, cinfo->rcvhdrq_entsize, cinfo->egrtids,
+			cinfo->rcvegr_size, cinfo->sdma_ring_size);
 
 	/* sanity checking... */
 	if (cinfo->rcvtids%8) {
@@ -454,12 +615,18 @@ struct _hfi_ctrl *hfi_userinit_internal(int fd, bool skip_affinity,
 	c.type = PSMI_HFI_CMD_USER_INFO;
 	c.len = sizeof(*binfo);
 	c.addr = (__u64) binfo;
+	hfi1_map_tracef("user_info request cmd_type=%u cmd_len=%u cmd_addr=%p "
+			"type=hfi1_base_info type_size=%zu", c.type, c.len,
+			(void *)(uintptr_t)c.addr, sizeof(*binfo));
 
 	if (hfi_cmd_write(fd, &c, sizeof(c)) == -1) {
+		hfi1_map_tracef("user_info result=-1 errno=%d", errno);
 		_HFI_ERROR("BASE_INFO command failed: %s\n", strerror(errno));
 		goto err_hfi_cmd_user_info;
 	}
 
+	hfi1_map_trace_base_info(binfo);
+
 	hfi_set_user_version(binfo->sw_version);
 
 	_HFI_VDBG("baseinfo: hwver %x, swver %x, jkey %d, qp %d\n",

