#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0-only
"""Pin this MPI rank to its own HFI-local physical core, then exec the command.

Binding to a NUMA node alone lets the scheduler place two polling ranks on the
two SMT threads of one physical core, which halves that pair's throughput and
shows up as a bimodal aggregate.  This picks one logical CPU per physical core
on the HFI-local node and gives local rank i the i-th of them.

Set HFI_LOCAL_RUN_DEBUG=1 to have the chosen CPU printed to stderr.
"""
import os
import sys


def cpulist(text):
    out = []
    for part in text.strip().split(","):
        if not part:
            continue
        if "-" in part:
            a, b = part.split("-")
            out.extend(range(int(a), int(b) + 1))
        else:
            out.append(int(part))
    return out


def read(path):
    with open(path) as f:
        return f.read()


def hfi_node():
    for name in sorted(os.listdir("/sys/class/infiniband")):
        try:
            node = int(read("/sys/class/infiniband/%s/device/numa_node" % name).strip())
        except (OSError, ValueError):
            continue
        return node
    return -1


def local_cores(node):
    """HFI-local CPUs, first thread of each physical core first.

    Ranks are handed CPUs in this order, so up to one rank per physical core
    lands on distinct cores; only beyond that do ranks start using the SMT
    siblings, and even then no two ranks share a logical CPU.
    """
    if node >= 0:
        try:
            allowed = set(cpulist(read("/sys/devices/system/node/node%d/cpulist" % node)))
        except OSError:
            allowed = None
    else:
        allowed = None

    first, rest = [], []
    for entry in os.listdir("/sys/devices/system/cpu"):
        if not entry.startswith("cpu") or not entry[3:].isdigit():
            continue
        cpu = int(entry[3:])
        if allowed is not None and cpu not in allowed:
            continue
        try:
            siblings = cpulist(read("/sys/devices/system/cpu/%s/topology/thread_siblings_list" % entry))
        except OSError:
            siblings = [cpu]
        if siblings and min(siblings) != cpu:
            rest.append(cpu)
        else:
            first.append(cpu)
    return sorted(first) + sorted(rest)


def main():
    argv = sys.argv[1:]
    if not argv:
        sys.exit("usage: hfi_local_run COMMAND [ARGS...]")

    rank = 0
    for var in ("OMPI_COMM_WORLD_LOCAL_RANK", "PMI_LOCAL_RANK", "MPI_LOCALRANKID"):
        if os.environ.get(var, "").isdigit():
            rank = int(os.environ[var])
            break

    node = hfi_node()
    cores = local_cores(node)
    if cores:
        cpu = cores[rank % len(cores)]
        try:
            os.sched_setaffinity(0, {cpu})
            if os.environ.get("HFI_LOCAL_RUN_DEBUG"):
                print("hfi_local_run: rank %d -> cpu %d (node %d)" % (rank, cpu, node), file=sys.stderr)
        except OSError as exc:
            print("hfi_local_run: affinity failed: %s" % exc, file=sys.stderr)
        if node >= 0:
            # Keep allocations on the HFI-local node as well.
            try:
                import ctypes
                libnuma = ctypes.CDLL("libnuma.so.1")
                if libnuma.numa_available() >= 0:
                    libnuma.numa_set_preferred(ctypes.c_int(node))
            except Exception:
                pass

    os.execvp(argv[0], argv)


if __name__ == "__main__":
    main()
